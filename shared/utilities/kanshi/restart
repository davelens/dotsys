#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../helper-env.sh"
[[ $# == 0 ]] || helper_fail 'Usage: kanshi restart (no arguments)'
case "$DOTSYS_PLATFORM" in
  arch|wsl) helper_need systemctl; exec systemctl --user restart kanshi.service ;;
  void)
    helper_need sv
    service="$XDG_CONFIG_HOME/service/kanshi"
    [[ -x $service/run ]] || helper_fail "Missing prepared turnstile service: $service; prepare it with dotsys."
    exec sv restart "$service"
    ;;
  *) helper_fail 'kanshi restart requires Arch/systemd or Void/turnstile.' ;;
esac
