{
  "additional-repositories": ["multilib"],
  "archinstall-language": "English",
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader_config": {
    "bootloader": "Grub",
    "uki": false,
    "removable": false
  },
  "hostname": "archvm",
  "kernels": ["linux"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": [
    "amd-ucode",
    "base-devel",
    "bash-completion",
    "bitwarden-cli",
    "btop",
    "cliphist",
    "cmake",
    "efibootmgr",
    "figlet",
    "foot",
    "fwupd",
    "fzf",
    "git",
    "git-crypt",
    "git-delta",
    "github-cli",
    "gnupg",
    "gnutls",
    "gpgme",
    "grub",
    "iwd",
    "jq",
    "keychain",
    "libyaml",
    "man-db",
    "mesa",
    "neovim",
    "networkmanager",
    "nmap",
    "openssh",
    "os-prober",
    "pavucontrol",
    "pipewire",
    "pipewire-alsa",
    "pipewire-jack",
    "pipewire-pulse",
    "python",
    "ripgrep",
    "rsync",
    "smartmontools",
    "sof-firmware",
    "starship",
    "tmux",
    "tree",
    "tree-sitter",
    "tree-sitter-cli",
    "unzip",
    "uwsm",
    "vulkan-nouveau",
    "vulkan-radeon",
    "wget",
    "wireless_tools",
    "wireplumber",
    "xdg-utils",
    "xf86-video-amdgpu",
    "xf86-video-ati",
    "xf86-video-nouveau"
  ],
  "parallel downloads": 5,
  "profile_config": {
    "profile": {
      "main": "Minimal"
    }
  },
  "swap": true,
  "timezone": "Europe/Brussels",
  "custom_commands": [
    "printf '%s\\n' 'davelens ALL=(ALL) NOPASSWD: ALL' 'Defaults timestamp_timeout=120' > /etc/sudoers.d/00_davelens && chmod 0440 /etc/sudoers.d/00_davelens",
    "systemctl enable sshd"
  ]
}
