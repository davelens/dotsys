#!/usr/bin/env bash
set -euo pipefail

SYSFS_ROOT="${GPU_CHECK_SYSFS_ROOT:-/sys}"
DRM_ROOT="$SYSFS_ROOT/class/drm"

DEVICE_WIDTH=28
ROLE_WIDTH=5
USE_WIDTH=20
TEMP_WIDTH=6
VRAM_WIDTH=10
# Sysfs reads on idle AMD GPUs can block indefinitely (gfxoff).
# All sysfs reads go through this wrapper.
SYSFS_TIMEOUT="${GPU_CHECK_SYSFS_TIMEOUT:-1}"

sysfs_read() {
  local file="$1"
  local fallback="${2:-}"

  if [[ -r "$file" ]]; then
    timeout "$SYSFS_TIMEOUT" cat "$file" 2>/dev/null || printf '%s' "$fallback"
  else
    printf '%s' "$fallback"
  fi
}

# Resolve device names from the local pci.ids database (no PCI bus access).
# lspci reads PCI config space which blocks when the dGPU is in gfxoff or
# under heavy load. pci.ids is a flat file lookup — instant and safe.
# For device IDs too new for pci.ids, fall back to a targeted single-slot
# lspci query (safe for the iGPU which never enters gfxoff).
PCIIDS_FILE=""
for _f in /usr/share/hwdata/pci.ids /usr/share/misc/pci.ids /usr/share/pci.ids; do
  [[ -r "$_f" ]] && PCIIDS_FILE="$_f" && break
done

lookup_pciids() {
  local vendor_id="$1"
  local device_id="$2"

  [[ -n "$PCIIDS_FILE" ]] || return 1

  local in_vendor=0

  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$line" ]] && continue

    if [[ ! "$line" =~ ^$'\t' ]]; then
      if [[ "$line" =~ ^"$vendor_id " ]]; then
        in_vendor=1
      elif (( in_vendor )); then
        break
      fi
      continue
    fi

    if (( in_vendor )) && [[ "$line" =~ ^$'\t'"$device_id " ]]; then
      local name="${line#*"$device_id "}"
      name="${name#"${name%%[! ]*}"}"
      printf '%s' "$name"
      return 0
    fi
  done <"$PCIIDS_FILE"

  return 1
}

lookup_lspci_slot() {
  local short_slot="$1"

  command -v lspci >/dev/null 2>&1 || return 1

  local raw
  raw="$(timeout 2 lspci -mm -s "$short_slot" 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1

  local parsed
  parsed="$(awk -F'"' '{print $6}' <<<"$raw")"
  [[ -n "$parsed" ]] && printf '%s' "$parsed" && return 0
  return 1
}

if [[ -t 1 && "${TERM:-}" != "dumb" ]]; then
  COLOR_RESET=$'\033[0m'
  COLOR_BORDER=$'\033[38;5;255m'
  COLOR_HEADER=$'\033[1;38;5;255m'
  COLOR_TEXT=$'\033[38;5;252m'
  COLOR_DGPU=$'\033[38;5;39m'
  COLOR_IGPU=$'\033[38;5;213m'
  COLOR_GOOD=$'\033[38;5;46m'
  COLOR_WARN=$'\033[38;5;220m'
  COLOR_BAD=$'\033[38;5;196m'
else
  COLOR_RESET=''
  COLOR_BORDER=''
  COLOR_HEADER=''
  COLOR_TEXT=''
  COLOR_DGPU=''
  COLOR_IGPU=''
  COLOR_GOOD=''
  COLOR_WARN=''
  COLOR_BAD=''
fi

usage() {
  echo "Usage: $(basename "$0") [--help]"
  echo
  echo "Show current AMD dGPU vs iGPU load and print a verdict."
  exit 0
}

read_uevent_value() {
  local file="$1"
  local key="$2"

  while IFS='=' read -r current_key value; do
    [[ "$current_key" == "$key" ]] && printf '%s\n' "$value" && return 0
  done <"$file"

  return 1
}

human_bytes() {
  local bytes="$1"

  if (( bytes >= 1073741824 )); then
    awk -v bytes="$bytes" 'BEGIN { printf "%.1f GiB", bytes / 1073741824 }'
  else
    awk -v bytes="$bytes" 'BEGIN { printf "%.0f MiB", bytes / 1048576 }'
  fi
}

friendly_name() {
  local slot="$1"
  local pci_id="$2"
  local vendor_id="${pci_id%%:*}"
  local device_id="${pci_id##*:}"
  local short_slot="${slot#0000:}"
  local name=""

  # Primary: pci.ids file (instant, no PCI bus access)
  name="$(lookup_pciids "$vendor_id" "$device_id" 2>/dev/null || true)"

  # Fallback: targeted lspci query for IDs not in pci.ids
  if [[ -z "$name" ]]; then
    name="$(lookup_lspci_slot "$short_slot" 2>/dev/null || true)"
  fi

  # Last resort: raw PCI ID
  [[ -z "$name" ]] && name="$pci_id"

  if [[ "$name" =~ \[(.*)\] ]]; then
    name="${BASH_REMATCH[1]}"
  fi

  if (( ${#name} > DEVICE_WIDTH )); then
    printf '%.'"$((DEVICE_WIDTH - 3))"'s...\n' "$name"
  else
    printf '%s\n' "$name"
  fi
}

classify_role() {
  local pci_class="$1"

  case "$pci_class" in
  30000)
    echo "dGPU"
    ;;
  38000)
    echo "iGPU"
    ;;
  *)
    echo "GPU"
    ;;
  esac
}

read_temp() {
  local render_path="$1"
  local hwmon_dir temp_raw

  for hwmon_dir in "$render_path"/device/hwmon/hwmon*; do
    [[ -d "$hwmon_dir" ]] || continue

    temp_raw="$(sysfs_read "$hwmon_dir/temp1_input" "")"

    if [[ -n "$temp_raw" ]]; then
      printf '%s' $(( temp_raw / 1000 ))
      return 0
    fi
  done

  printf '%s' "-"
}

repeat_char() {
  local char="$1"
  local count="$2"
  local out=""

  while (( count > 0 )); do
    out+="$char"
    ((count--))
  done

  printf '%s' "$out"
}

cell_width() {
  local width="$1"
  printf '%s' $((width + 2))
}

table_inner_width() {
  printf '%s' $(( $(cell_width "$DEVICE_WIDTH") + $(cell_width "$ROLE_WIDTH") + $(cell_width "$USE_WIDTH") + $(cell_width "$TEMP_WIDTH") + $(cell_width "$VRAM_WIDTH") + 4 ))
}

border_line() {
  local left="$1"
  local fill="$2"
  local join="$3"
  local right="$4"

  printf '%s%s%s%s%s%s%s%s%s%s%s\n' \
    "$COLOR_BORDER$left" \
    "$(repeat_char "$fill" "$(cell_width "$DEVICE_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$ROLE_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$USE_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$TEMP_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$VRAM_WIDTH")")" \
    "$right$COLOR_RESET"
}

bar_color() {
  local busy="$1"

  if (( busy >= 90 )); then
    printf '%s' "$COLOR_BAD"
  elif (( busy >= 50 )); then
    printf '%s' "$COLOR_WARN"
  else
    printf '%s' "$COLOR_GOOD"
  fi
}

render_busy_bar() {
  local busy="$1"
  local pct_text
  pct_text="$(printf '%3s%%' "$busy")"
  local pct_len=4
  local bar_space=$(( USE_WIDTH - pct_len - 1 ))
  local filled=$(( busy * bar_space / 100 ))
  local empty=$(( bar_space - filled ))

  if (( busy > 0 && filled == 0 )); then
    filled=1
    empty=$(( bar_space - filled ))
  fi

  # Manual padding: printf %*s miscounts multibyte █ characters
  printf '%s%s %s' \
    "$(repeat_char '█' "$filled")" \
    "$(repeat_char ' ' "$empty")" \
    "$pct_text"
}

print_title_row() {
  local title="GPU Check"
  local width
  width="$(table_inner_width)"
  local padding=$(( width - ${#title} - 2 ))
  printf '%s│ %s%s%s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_HEADER" "$title" "$COLOR_RESET" \
    "$(repeat_char ' ' "$padding")" \
    "$COLOR_RESET"
}

center_text() {
  local text="$1"
  local width="$2"
  local text_len=${#text}
  local left_pad=$(( (width - text_len) / 2 ))
  local right_pad=$(( width - text_len - left_pad ))

  printf '%s%s%s' \
    "$(repeat_char ' ' "$left_pad")" \
    "$text" \
    "$(repeat_char ' ' "$right_pad")"
}

print_header_row() {
  local use_centered
  use_centered="$(center_text "USE%" "$USE_WIDTH")"

  printf '%s│ %s%-*s%s │ %s%-*s%s │ %s%s%s │ %s%-*s%s │ %s%-*s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_HEADER" "$DEVICE_WIDTH" "DEVICE" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$ROLE_WIDTH" "ROLE" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$use_centered" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$TEMP_WIDTH" "TEMP" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$VRAM_WIDTH" "VRAM" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_RESET"
}

print_row() {
  local name="$1"
  local role="$2"
  local busy="$3"
  local temp="$4"
  local vram="$5"
  local busy_text busy_color role_color temp_text

  busy_text="$(render_busy_bar "$busy")"
  busy_color="$(bar_color "$busy")"

  # Manual right-align: printf %*s miscounts multibyte ° character.
  # Visual columns: "-" = 1, "36°" = 3 (digits + degree symbol = 1 col each).
  local temp_val temp_val_cols
  if [[ "$temp" == "-" ]]; then
    temp_val="-"
    temp_val_cols=1
  else
    temp_val="${temp}°"
    temp_val_cols=$(( ${#temp} + 1 ))
  fi
  local temp_pad=$(( TEMP_WIDTH - temp_val_cols ))
  temp_text="$(repeat_char ' ' "$temp_pad")${temp_val}"

  case "$role" in
  dGPU)
    role_color="$COLOR_DGPU"
    ;;
  iGPU)
    role_color="$COLOR_IGPU"
    ;;
  *)
    role_color="$COLOR_TEXT"
    ;;
  esac

  # busy_text and temp_text are pre-padded to exact column width;
  # do not use printf width specifiers on them (multibyte chars miscount).
  printf '%s│ %s%-*s%s │ %s%-*s%s │ %s%s%s │ %s%s%s │ %s%*s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_TEXT" "$DEVICE_WIDTH" "$name" "$COLOR_RESET$COLOR_BORDER" \
    "$role_color" "$ROLE_WIDTH" "$role" "$COLOR_RESET$COLOR_BORDER" \
    "$busy_color" "$busy_text" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_TEXT" "$temp_text" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_TEXT" "$VRAM_WIDTH" "$(human_bytes "$vram")" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_RESET"
}

print_verdict_row() {
  local verdict="$1"
  local width
  width="$(table_inner_width)"
  local padding=$(( width - ${#verdict} - 2 ))
  printf '%s│ %s%s%s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_TEXT" "$verdict" "$COLOR_RESET" \
    "$(repeat_char ' ' "$padding")" \
    "$COLOR_RESET"
}

collect_gpu() {
  local render_path="$1"
  local uevent="$render_path/device/uevent"

  [[ -f "$uevent" ]] || return 1

  local driver
  driver="$(read_uevent_value "$uevent" DRIVER 2>/dev/null || true)"
  [[ "$driver" == "amdgpu" ]] || return 1

  local busy_file="$render_path/device/gpu_busy_percent"
  local vram_file="$render_path/device/mem_info_vram_used"

  if [[ ! -r "$busy_file" || ! -r "$vram_file" ]]; then
    echo "Error: Missing AMD GPU counters under $render_path/device" >&2
    exit 2
  fi

  local pci_class slot pci_id busy vram name role temp
  pci_class="$(read_uevent_value "$uevent" PCI_CLASS 2>/dev/null || true)"
  slot="$(read_uevent_value "$uevent" PCI_SLOT_NAME 2>/dev/null || true)"
  pci_id="$(read_uevent_value "$uevent" PCI_ID 2>/dev/null || true)"
  busy="$(sysfs_read "$busy_file" "0")"
  busy="${busy%%[[:space:]]}"
  vram="$(sysfs_read "$vram_file" "0")"
  vram="${vram%%[[:space:]]}"
  role="$(classify_role "$pci_class")"
  name="$(friendly_name "$slot" "$pci_id")"
  temp="$(read_temp "$render_path")"

  printf '%s\t%s\t%s\t%s\t%s\n' "$role" "$name" "$busy" "$temp" "$vram"
}

[[ $# -gt 0 && "$1" =~ ^(-h|--help)$ ]] && usage

if [[ ! -d "$DRM_ROOT" ]]; then
  echo "Error: DRM sysfs root not found at $DRM_ROOT" >&2
  exit 2
fi

shopt -s nullglob

dgpu_line=""
igpu_line=""
unknown_lines=()

for render_path in "$DRM_ROOT"/renderD*; do
  line="$(collect_gpu "$render_path" || true)"
  [[ -n "$line" ]] || continue

  role="${line%%$'\t'*}"

  case "$role" in
  dGPU)
    dgpu_line="$line"
    ;;
  iGPU)
    igpu_line="$line"
    ;;
  *)
    unknown_lines+=("$line")
    ;;
  esac
done

if [[ -z "$dgpu_line" && -z "$igpu_line" && ${#unknown_lines[@]} -eq 0 ]]; then
  echo "Error: No AMD GPUs found under $DRM_ROOT" >&2
  exit 2
fi

printf '%s%s%s\n' "$COLOR_BORDER" "╭$(repeat_char '─' "$(table_inner_width)")╮" "$COLOR_RESET"
print_title_row
border_line '├' '─' '┬' '┤'
print_header_row
border_line '├' '─' '┼' '┤'

if [[ -n "$dgpu_line" ]]; then
  IFS=$'\t' read -r role name busy temp vram <<<"$dgpu_line"
  print_row "$name" "$role" "$busy" "$temp" "$vram"
fi

if [[ -n "$igpu_line" ]]; then
  IFS=$'\t' read -r role name busy temp vram <<<"$igpu_line"
  print_row "$name" "$role" "$busy" "$temp" "$vram"
fi

for line in "${unknown_lines[@]}"; do
  IFS=$'\t' read -r role name busy temp vram <<<"$line"
  print_row "$name" "$role" "$busy" "$temp" "$vram"
done

if [[ -z "$dgpu_line" || -z "$igpu_line" ]]; then
  border_line '├' '─' '┴' '┤'
  print_verdict_row 'Verdict: cannot compare dGPU vs iGPU on this host'
  printf '%s%s%s\n' "$COLOR_BORDER" "╰$(repeat_char '─' "$(table_inner_width)")╯" "$COLOR_RESET"
  exit 2
fi

IFS=$'\t' read -r _ _ dgpu_busy _ _ <<<"$dgpu_line"
IFS=$'\t' read -r _ _ igpu_busy _ _ <<<"$igpu_line"

if (( dgpu_busy > igpu_busy )); then
  border_line '├' '─' '┴' '┤'
  print_verdict_row 'Verdict: dGPU active and dominant'
  printf '%s%s%s\n' "$COLOR_BORDER" "╰$(repeat_char '─' "$(table_inner_width)")╯" "$COLOR_RESET"
  exit 0
fi

border_line '├' '─' '┴' '┤'
print_verdict_row 'Verdict: dGPU not dominant right now'
printf '%s%s%s\n' "$COLOR_BORDER" "╰$(repeat_char '─' "$(table_inner_width)")╯" "$COLOR_RESET"
exit 1
