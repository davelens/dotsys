#!/usr/bin/env bash
set -euo pipefail

SYSFS_ROOT="${GPU_CHECK_SYSFS_ROOT:-/sys}"
DRM_ROOT="$SYSFS_ROOT/class/drm"

DEVICE_WIDTH=38
ROLE_WIDTH=5
BAR_WIDTH=20
USE_WIDTH=$(( BAR_WIDTH + 1 + 3 ))
TEMP_WIDTH=4
VRAM_WIDTH=16
# Sysfs reads on idle GPUs can block indefinitely (e.g. AMD gfxoff).
# All sysfs reads go through this wrapper.
SYSFS_TIMEOUT="${GPU_CHECK_SYSFS_TIMEOUT:-1}"

sysfs_read() {
  local file="$1"
  local fallback="${2:-}"

  if [[ -r "$file" ]]; then
    timeout "$SYSFS_TIMEOUT" cat "$file" 2>/dev/null || printf '%s' "$fallback"
  else
    printf '%s' "$fallback"
  fi
}

# Resolve device names from the local pci.ids database (no PCI bus access).
# lspci reads PCI config space which blocks when the dGPU is in gfxoff or
# under heavy load. pci.ids is a flat file lookup — instant and safe.
# For device IDs too new for pci.ids, fall back to a targeted single-slot
# lspci query (safe for the iGPU which never enters gfxoff).
PCIIDS_FILE=""
for _f in /usr/share/hwdata/pci.ids /usr/share/misc/pci.ids /usr/share/pci.ids; do
  [[ -r "$_f" ]] && PCIIDS_FILE="$_f" && break
done

lookup_pciids() {
  local vendor_id="$1"
  local device_id="$2"

  [[ -n "$PCIIDS_FILE" ]] || return 1

  local in_vendor=0

  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$line" ]] && continue

    if [[ ! "$line" =~ ^$'\t' ]]; then
      if [[ "$line" =~ ^"$vendor_id " ]]; then
        in_vendor=1
      elif (( in_vendor )); then
        break
      fi
      continue
    fi

    if (( in_vendor )) && [[ "$line" =~ ^$'\t'"$device_id " ]]; then
      local name="${line#*"$device_id "}"
      name="${name#"${name%%[! ]*}"}"
      printf '%s' "$name"
      return 0
    fi
  done <"$PCIIDS_FILE"

  return 1
}

lookup_lspci_slot() {
  local short_slot="$1"

  command -v lspci >/dev/null 2>&1 || return 1

  local raw
  raw="$(timeout 2 lspci -mm -s "$short_slot" 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1

  local parsed
  parsed="$(awk -F'"' '{print $6}' <<<"$raw")"
  [[ -n "$parsed" ]] && printf '%s' "$parsed" && return 0
  return 1
}

if [[ -t 1 && "${TERM:-}" != "dumb" ]]; then
  COLOR_RESET=$'\033[0m'
  COLOR_BORDER=$'\033[38;5;255m'
  COLOR_HEADER=$'\033[1;38;5;255m'
  COLOR_TEXT=$'\033[38;5;252m'
  COLOR_DGPU=$'\033[38;5;39m'
  COLOR_IGPU=$'\033[38;5;213m'
  # duf dark theme palette
  COLOR_GOOD=$'\033[38;2;168;204;140m'
  COLOR_WARN=$'\033[38;2;219;171;121m'
  COLOR_BAD=$'\033[38;2;232;131;136m'
  COLOR_BAR_BG=$'\033[48;2;27;45;27m'
else
  COLOR_RESET=''
  COLOR_BORDER=''
  COLOR_HEADER=''
  COLOR_TEXT=''
  COLOR_DGPU=''
  COLOR_IGPU=''
  COLOR_GOOD=''
  COLOR_WARN=''
  COLOR_BAD=''
  COLOR_BAR_BG=''
fi

usage() {
  echo "Usage: $(basename "$0") [--help]"
  echo
  echo "Show current GPU load, temperature, and VRAM usage."
  exit 0
}

read_uevent_value() {
  local file="$1"
  local key="$2"

  while IFS='=' read -r current_key value; do
    [[ "$current_key" == "$key" ]] && printf '%s\n' "$value" && return 0
  done <"$file"

  return 1
}

human_bytes() {
  local bytes="$1"

  if [[ "$bytes" == "-" ]]; then
    printf '%s' "-"
  elif (( bytes >= 1073741824 )); then
    awk -v bytes="$bytes" 'BEGIN { printf "%.1f GiB", bytes / 1073741824 }'
  else
    awk -v bytes="$bytes" 'BEGIN { printf "%.0f MiB", bytes / 1048576 }'
  fi
}

# Format VRAM as "used / total" in the same unit, or "-" when unavailable.
human_vram() {
  local used="$1"
  local total="$2"

  if [[ "$used" == "-" || "$total" == "-" ]]; then
    printf '%s' "-"
    return
  fi

  if (( total >= 1073741824 )); then
    awk -v u="$used" -v t="$total" \
      'BEGIN { printf "%.1f / %.0f GiB", u / 1073741824, t / 1073741824 }'
  else
    awk -v u="$used" -v t="$total" \
      'BEGIN { printf "%.0f / %.0f MiB", u / 1048576, t / 1048576 }'
  fi
}

friendly_name() {
  local slot="$1"
  local pci_id="$2"
  local vendor_id="${pci_id%%:*}"
  local device_id="${pci_id##*:}"
  local short_slot="${slot#0000:}"
  local name=""

  # Primary: pci.ids file (instant, no PCI bus access)
  name="$(lookup_pciids "$vendor_id" "$device_id" 2>/dev/null || true)"

  # Fallback: targeted lspci query for IDs not in pci.ids
  if [[ -z "$name" ]]; then
    name="$(lookup_lspci_slot "$short_slot" 2>/dev/null || true)"
  fi

  # Last resort: raw PCI ID
  [[ -z "$name" ]] && name="$pci_id"

  if [[ "$name" =~ \[(.*)\] ]]; then
    name="${BASH_REMATCH[1]}"
  fi

  if (( ${#name} > DEVICE_WIDTH )); then
    printf '%.'"$((DEVICE_WIDTH - 3))"'s...\n' "$name"
  else
    printf '%s\n' "$name"
  fi
}

classify_role() {
  local vendor_id="$1"
  local vram_total="$2"

  case "$vendor_id" in
  10DE)
    echo "dGPU"
    ;;
  8086)
    echo "iGPU"
    ;;
  1002)
    if [[ "$vram_total" =~ ^[0-9]+$ ]]; then
      if (( vram_total <= 1073741824 )); then
        echo "iGPU"
      else
        echo "dGPU"
      fi
    else
      echo "GPU"
    fi
    ;;
  *)
    echo "GPU"
    ;;
  esac
}

read_temp() {
  local render_path="$1"
  local hwmon_dir temp_raw

  for hwmon_dir in "$render_path"/device/hwmon/hwmon*; do
    [[ -d "$hwmon_dir" ]] || continue

    temp_raw="$(sysfs_read "$hwmon_dir/temp1_input" "")"

    if [[ -n "$temp_raw" ]]; then
      printf '%s' $(( temp_raw / 1000 ))
      return 0
    fi
  done

  printf '%s' "-"
}

repeat_char() {
  local char="$1"
  local count="$2"
  local out=""

  while (( count > 0 )); do
    out+="$char"
    ((count--))
  done

  printf '%s' "$out"
}

cell_width() {
  local width="$1"
  printf '%s' $((width + 2))
}

table_inner_width() {
  printf '%s' $(( $(cell_width "$DEVICE_WIDTH") + $(cell_width "$ROLE_WIDTH") + $(cell_width "$USE_WIDTH") + $(cell_width "$TEMP_WIDTH") + $(cell_width "$VRAM_WIDTH") + 4 ))
}

border_line() {
  local left="$1"
  local fill="$2"
  local join="$3"
  local right="$4"

  printf '%s%s%s%s%s%s%s%s%s%s%s\n' \
    "$COLOR_BORDER$left" \
    "$(repeat_char "$fill" "$(cell_width "$DEVICE_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$ROLE_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$USE_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$TEMP_WIDTH")")" \
    "$join" \
    "$(repeat_char "$fill" "$(cell_width "$VRAM_WIDTH")")" \
    "$right$COLOR_RESET"
}

bar_color() {
  local busy="$1"

  if (( busy >= 90 )); then
    printf '%s' "$COLOR_BAD"
  elif (( busy >= 50 )); then
    printf '%s' "$COLOR_WARN"
  else
    printf '%s' "$COLOR_GOOD"
  fi
}

render_busy_bar() {
  local busy="$1"
  local pct_text="${busy}%"
  local pct_len=${#pct_text}
  # Right-align percentage within the space after the bar.
  local pct_pad=$(( USE_WIDTH - BAR_WIDTH - pct_len ))
  local filled=$(( busy * BAR_WIDTH / 100 ))
  local empty=$(( BAR_WIDTH - filled ))

  if (( busy > 0 && filled == 0 )); then
    filled=1
    empty=$(( BAR_WIDTH - filled ))
  fi

  # Manual padding: printf %*s miscounts multibyte █ characters.
  # Empty bar space gets a dark green background to show full bar width.
  # The gap between bar and percentage is included in the bg region,
  # leaving only a single plain space as separator.
  local bg_extra=$(( pct_pad - 1 ))
  printf '%s%s%s%s %s' \
    "$(repeat_char '█' "$filled")" \
    "$COLOR_BAR_BG" \
    "$(repeat_char ' ' $(( empty + bg_extra )))" \
    "$COLOR_RESET" \
    "$pct_text"
}

print_title_row() {
  local title="GPU Check"
  local width
  width="$(table_inner_width)"
  local padding=$(( width - ${#title} - 2 ))
  printf '%s│ %s%s%s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_HEADER" "$title" "$COLOR_RESET" \
    "$(repeat_char ' ' "$padding")" \
    "$COLOR_RESET"
}

center_text() {
  local text="$1"
  local width="$2"
  local text_len=${#text}
  local left_pad=$(( (width - text_len) / 2 ))
  local right_pad=$(( width - text_len - left_pad ))

  printf '%s%s%s' \
    "$(repeat_char ' ' "$left_pad")" \
    "$text" \
    "$(repeat_char ' ' "$right_pad")"
}

print_header_row() {
  local use_centered
  use_centered="$(center_text "USE%" "$USE_WIDTH")"

  printf '%s│ %s%-*s%s │ %s%-*s%s │ %s%s%s │ %s%-*s%s │ %s%-*s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_HEADER" "$DEVICE_WIDTH" "DEVICE" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$ROLE_WIDTH" "ROLE" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$use_centered" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$TEMP_WIDTH" "TEMP" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_HEADER" "$VRAM_WIDTH" "VRAM" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_RESET"
}

print_row() {
  local name="$1"
  local role="$2"
  local busy="$3"
  local temp="$4"
  local vram_used="$5"
  local vram_total="$6"
  local busy_text busy_color role_color temp_text

  if [[ "$busy" == "-" ]]; then
    # Right-align the dash within the USE_WIDTH column.
    local dash_pad=$(( USE_WIDTH - 1 ))
    busy_text="$(repeat_char ' ' "$dash_pad")-"
    busy_color="$COLOR_TEXT"
  else
    busy_text="$(render_busy_bar "$busy")"
    busy_color="$(bar_color "$busy")"
  fi

  # Manual right-align: printf %*s miscounts multibyte ° character.
  # Visual columns: "-" = 1, "36°" = 3 (digits + degree symbol = 1 col each).
  local temp_val temp_val_cols
  if [[ "$temp" == "-" ]]; then
    temp_val="-"
    temp_val_cols=1
  else
    temp_val="${temp}°"
    temp_val_cols=$(( ${#temp} + 1 ))
  fi
  local temp_pad=$(( TEMP_WIDTH - temp_val_cols ))
  temp_text="$(repeat_char ' ' "$temp_pad")${temp_val}"

  case "$role" in
  dGPU)
    role_color="$COLOR_DGPU"
    ;;
  iGPU)
    role_color="$COLOR_IGPU"
    ;;
  *)
    role_color="$COLOR_TEXT"
    ;;
  esac

  # busy_text and temp_text are pre-padded to exact column width;
  # do not use printf width specifiers on them (multibyte chars miscount).
  printf '%s│ %s%-*s%s │ %s%-*s%s │ %s%s%s │ %s%s%s │ %s%*s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_TEXT" "$DEVICE_WIDTH" "$name" "$COLOR_RESET$COLOR_BORDER" \
    "$role_color" "$ROLE_WIDTH" "$role" "$COLOR_RESET$COLOR_BORDER" \
    "$busy_color" "$busy_text" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_TEXT" "$temp_text" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_TEXT" "$VRAM_WIDTH" "$(human_vram "$vram_used" "$vram_total")" "$COLOR_RESET$COLOR_BORDER" \
    "$COLOR_RESET"
}

print_verdict_row() {
  local verdict="$1"
  local width
  width="$(table_inner_width)"
  local padding=$(( width - ${#verdict} - 2 ))
  printf '%s│ %s%s%s%s │%s\n' \
    "$COLOR_BORDER" \
    "$COLOR_TEXT" "$verdict" "$COLOR_RESET" \
    "$(repeat_char ' ' "$padding")" \
    "$COLOR_RESET"
}

collect_gpu() {
  local render_path="$1"
  local uevent="$render_path/device/uevent"

  [[ -f "$uevent" ]] || return 1

  local busy_file="$render_path/device/gpu_busy_percent"

  local vram_used_file="$render_path/device/mem_info_vram_used"
  local vram_total_file="$render_path/device/mem_info_vram_total"

  local slot pci_id vendor_id busy vram_used vram_total name role temp
  slot="$(read_uevent_value "$uevent" PCI_SLOT_NAME 2>/dev/null || true)"
  pci_id="$(read_uevent_value "$uevent" PCI_ID 2>/dev/null || true)"
  vendor_id="${pci_id%%:*}"
  if [[ -r "$busy_file" ]]; then
    busy="$(sysfs_read "$busy_file" "0")"
    busy="${busy%%[[:space:]]}"
  else
    busy="-"
  fi
  if [[ -r "$vram_used_file" ]]; then
    vram_used="$(sysfs_read "$vram_used_file" "0")"
    vram_used="${vram_used%%[[:space:]]}"
  else
    vram_used="-"
  fi
  if [[ -r "$vram_total_file" ]]; then
    vram_total="$(sysfs_read "$vram_total_file" "0")"
    vram_total="${vram_total%%[[:space:]]}"
  else
    vram_total="-"
  fi
  role="$(classify_role "$vendor_id" "$vram_total")"
  name="$(friendly_name "$slot" "$pci_id")"
  temp="$(read_temp "$render_path")"

  if [[ "$vendor_id" == "10DE" ]]; then
    local nvidia_line nvidia_name nvidia_busy nvidia_temp nvidia_vram_used nvidia_vram_total
    nvidia_line="$(lookup_nvidia_metrics "$slot" || true)"
    if [[ -n "$nvidia_line" ]]; then
      IFS=$'\t' read -r nvidia_name nvidia_busy nvidia_temp nvidia_vram_used nvidia_vram_total <<<"$nvidia_line"
      [[ "$nvidia_name" != "-" ]] && name="$nvidia_name"
      [[ "$nvidia_busy" != "-" ]] && busy="$nvidia_busy"
      [[ "$nvidia_temp" != "-" ]] && temp="$nvidia_temp"
      [[ "$nvidia_vram_used" != "-" ]] && vram_used="$nvidia_vram_used"
      [[ "$nvidia_vram_total" != "-" ]] && vram_total="$nvidia_vram_total"
    fi
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$role" "$name" "$busy" "$temp" "$vram_used" "$vram_total"
}

# Find nvidia-smi: check $PATH first, then the WSL2 library path.
find_nvidia_smi() {
  local smi
  smi="$(command -v nvidia-smi 2>/dev/null || true)"
  [[ -n "$smi" ]] && printf '%s' "$smi" && return 0

  [[ -x /usr/lib/wsl/lib/nvidia-smi ]] && printf '%s' /usr/lib/wsl/lib/nvidia-smi && return 0

  return 1
}

NVIDIA_SMI_CSV=""

get_nvidia_smi_csv() {
  [[ -n "$NVIDIA_SMI_CSV" ]] && printf '%s' "$NVIDIA_SMI_CSV" && return 0

  local smi
  smi="$(find_nvidia_smi)" || return 1

  NVIDIA_SMI_CSV="$(timeout 5 "$smi" \
    --query-gpu=pci.bus_id,name,utilization.gpu,temperature.gpu,memory.used,memory.total \
    --format=csv,noheader,nounits 2>/dev/null || true)"

  [[ -n "$NVIDIA_SMI_CSV" ]] || return 1
  printf '%s' "$NVIDIA_SMI_CSV"
}

lookup_nvidia_metrics() {
  local slot="$1"
  local short_slot="${slot#0000:}"
  local csv
  csv="$(get_nvidia_smi_csv)" || return 1

  while IFS=',' read -r raw_slot raw_name raw_busy raw_temp raw_used raw_total; do
    local smi_slot name busy temp vram_used vram_total

    smi_slot="${raw_slot#"${raw_slot%%[! ]*}"}"
    smi_slot="${smi_slot%"${smi_slot##*[! ]}"}"
    [[ "$smi_slot" == *":$short_slot" ]] || continue

    name="${raw_name#"${raw_name%%[! ]*}"}"
    name="${name%"${name##*[! ]}"}"
    busy="${raw_busy#"${raw_busy%%[! ]*}"}"
    busy="${busy%"${busy##*[! ]}"}"
    temp="${raw_temp#"${raw_temp%%[! ]*}"}"
    temp="${temp%"${temp##*[! ]}"}"
    vram_used="${raw_used#"${raw_used%%[! ]*}"}"
    vram_used="${vram_used%"${vram_used##*[! ]}"}"
    vram_total="${raw_total#"${raw_total%%[! ]*}"}"
    vram_total="${vram_total%"${vram_total##*[! ]}"}"

    [[ "$busy" =~ ^[0-9]+$ ]] || busy="-"
    [[ "$temp" =~ ^[0-9]+$ ]] || temp="-"
    if [[ "$vram_used" =~ ^[0-9]+$ ]]; then
      vram_used=$(( vram_used * 1048576 ))
    else
      vram_used="-"
    fi
    if [[ "$vram_total" =~ ^[0-9]+$ ]]; then
      vram_total=$(( vram_total * 1048576 ))
    else
      vram_total="-"
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$busy" "$temp" "$vram_used" "$vram_total"
    return 0
  done <<<"$csv"

  return 1
}

# Collect GPU lines from nvidia-smi (NVIDIA / WSL2 fallback).
collect_nvidia_gpus() {
  local csv
  csv="$(get_nvidia_smi_csv)" || return 1

  while IFS=',' read -r _ raw_name raw_busy raw_temp raw_used raw_total; do
    # Trim leading/trailing whitespace.
    local name busy temp vram_used vram_total role
    name="${raw_name#"${raw_name%%[! ]*}"}"
    name="${name%"${name##*[! ]}"}"
    busy="${raw_busy#"${raw_busy%%[! ]*}"}"
    busy="${busy%"${busy##*[! ]}"}"
    temp="${raw_temp#"${raw_temp%%[! ]*}"}"
    temp="${temp%"${temp##*[! ]}"}"
    vram_used="${raw_used#"${raw_used%%[! ]*}"}"
    vram_used="${vram_used%"${vram_used##*[! ]}"}"
    vram_total="${raw_total#"${raw_total%%[! ]*}"}"
    vram_total="${vram_total%"${vram_total##*[! ]}"}"

    # Convert MiB to bytes for human_vram().
    local vram_used_bytes vram_total_bytes
    if [[ "$vram_used" =~ ^[0-9]+$ ]]; then
      vram_used_bytes=$(( vram_used * 1048576 ))
    else
      vram_used_bytes="-"
    fi
    if [[ "$vram_total" =~ ^[0-9]+$ ]]; then
      vram_total_bytes=$(( vram_total * 1048576 ))
    else
      vram_total_bytes="-"
    fi

    # nvidia-smi doesn't distinguish dGPU/iGPU; label as GPU.
    role="GPU"

    # Truncate name to fit the column.
    if (( ${#name} > DEVICE_WIDTH )); then
      name="$(printf '%.'"$((DEVICE_WIDTH - 3))"'s...' "$name")"
    fi

    [[ "$busy" =~ ^[0-9]+$ ]] || busy="-"
    [[ "$temp" =~ ^[0-9]+$ ]] || temp="-"

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$role" "$name" "$busy" "$temp" "$vram_used_bytes" "$vram_total_bytes"
  done <<<"$csv"
}

[[ $# -gt 0 && "$1" =~ ^(-h|--help)$ ]] && usage

shopt -s nullglob

gpu_lines=()

# Primary: DRM sysfs render nodes (native Linux / AMD / Intel).
if [[ -d "$DRM_ROOT" ]]; then
  for render_path in "$DRM_ROOT"/renderD*; do
    line="$(collect_gpu "$render_path" || true)"
    [[ -n "$line" ]] || continue
    gpu_lines+=("$line")
  done
fi

# Fallback: nvidia-smi (NVIDIA native + WSL2).
if [[ ${#gpu_lines[@]} -eq 0 ]]; then
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    gpu_lines+=("$line")
  done < <(collect_nvidia_gpus 2>/dev/null || true)
fi

if [[ ${#gpu_lines[@]} -eq 0 ]]; then
  echo "Error: No GPUs found (checked DRM sysfs and nvidia-smi)" >&2
  exit 2
fi

# Recalculate USE_WIDTH: bar is fixed, column grows if any value hits 100%.
max_busy=0
for _line in "${gpu_lines[@]}"; do
  IFS=$'\t' read -r _ _ _busy _ _ <<<"$_line"
  [[ "$_busy" == "-" ]] && continue
  (( _busy > max_busy )) && max_busy=$_busy
done
max_pct_len=${#max_busy}
(( max_pct_len < 2 )) && max_pct_len=2
USE_WIDTH=$(( BAR_WIDTH + 1 + max_pct_len + 1 ))

printf '%s%s%s\n' "$COLOR_BORDER" "╭$(repeat_char '─' "$(table_inner_width)")╮" "$COLOR_RESET"
print_title_row
border_line '├' '─' '┬' '┤'
print_header_row
border_line '├' '─' '┼' '┤'

for line in "${gpu_lines[@]}"; do
  IFS=$'\t' read -r role name busy temp vram_used vram_total <<<"$line"
  print_row "$name" "$role" "$busy" "$temp" "$vram_used" "$vram_total"
done

# Only print a verdict when there are 2+ GPUs to compare.
if (( ${#gpu_lines[@]} >= 2 )); then
  # Find the busiest GPU.
  best_name=""
  best_busy=0
  for _line in "${gpu_lines[@]}"; do
    IFS=$'\t' read -r _role _name _busy _ _ <<<"$_line"
    [[ "$_busy" == "-" ]] && continue
    if (( _busy > best_busy )); then
      best_busy=$_busy
      best_name="$_name"
    fi
  done

  border_line '├' '─' '┴' '┤'
  if (( best_busy > 0 )); then
    print_verdict_row "Verdict: $best_name is dominant (${best_busy}%)"
  else
    print_verdict_row 'Verdict: no GPU is dominant right now'
  fi
  printf '%s%s%s\n' "$COLOR_BORDER" "╰$(repeat_char '─' "$(table_inner_width)")╯" "$COLOR_RESET"
else
  border_line '╰' '─' '┴' '╯'
fi
